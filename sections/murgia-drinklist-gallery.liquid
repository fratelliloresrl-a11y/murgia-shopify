<section class="murgia-drinklist">

  <div class="murgia-drinklist__header">

    {% if section.settings.eyebrow != blank %}
      <p class="murgia-drinklist__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    <h1 class="murgia-drinklist__title">
      {{ section.settings.title }}
    </h1>

    {% if section.settings.text != blank %}
      <div class="murgia-drinklist__intro">
        {{ section.settings.text }}
      </div>
    {% endif %}

  </div>


  <div class="murgia-drinklist__cocktails">

    {% for block in section.blocks %}

      <div class="murgia-drink">

        Cocktail

      </div>

    {% endfor %}

  </div>

</section>
<style>
  #shopify-section-{{ section.id }} {
    background: #efe2cf;
  }

  .murgia-drinklist {
    background: #efe2cf;
    color: #24152e;
  }

  .murgia-drinklist__header {
    width: min(calc(100% - 48px), 1380px);
    margin: 0 auto;
    padding: 54px 0 58px;
  }

  .murgia-drinklist__eyebrow {
    margin: 0 0 14px;
    color: #8d536d;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .28em;
    text-transform: uppercase;
  }

  .murgia-drinklist__title {
    max-width: 12ch;
    margin: 0;
    color: inherit;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(54px, 6vw, 92px);
    font-style: normal;
    font-weight: 400;
    line-height: .95;
    letter-spacing: -.045em;
  }

  .murgia-drinklist__intro {
    max-width: 620px;
    margin-top: 24px;
    font-size: 18px;
    line-height: 1.6;
  }

  .murgia-drinklist__intro p {
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .murgia-drinklist__header {
      width: calc(100% - 40px);
      padding: 38px 0 42px;
    }

    .murgia-drinklist__title {
      font-size: clamp(48px, 14vw, 66px);
    }
  }
</style>

{% schema %}
{
  "name": "Murgia Drink List",
  "settings": [

    {
  "type": "image_picker",
  "id": "image",
  "label": "Foto cocktail"
},
{
  "type": "checkbox",
  "id": "image_left",
  "label": "Foto a sinistra",
  "default": true
},
{
  "type": "text",
  "id": "title",
  "label": "Nome cocktail"
},
{
  "type": "textarea",
  "id": "description",
  "label": "Descrizione"
},
{
  "type": "range",
  "id": "difficulty",
  "label": "Difficoltà",
  "min": 1,
  "max": 3,
  "step": 1,
  "default": 2
},
{
  "type": "richtext",
  "id": "ingredients",
  "label": "Ingredienti"
},
{
  "type": "richtext",
  "id": "preparation",
  "label": "Preparazione"
},
{
  "type": "text",
  "id": "garnish",
  "label": "Garnish"
}

  ],

  "presets":[

    {
      "name":"Murgia Drink List"
    }

  ]

}
{% endschema %}