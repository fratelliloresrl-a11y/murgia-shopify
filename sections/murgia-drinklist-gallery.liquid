<section class="murgia-drinklist">

  <div class="murgia-drinklist__header">

    {% if section.settings.eyebrow != blank %}
      <p class="murgia-drinklist__eyebrow">
        {{ section.settings.eyebrow }}
      </p>
    {% endif %}

    <h1 class="murgia-drinklist__title">
      {{ section.settings.title }}
    </h1>

    {% if section.settings.text != blank %}
      <div class="murgia-drinklist__intro">
        {{ section.settings.text }}
      </div>
    {% endif %}

  </div>


  <div class="murgia-drinklist__cocktails">

    {% for block in section.blocks %}

      <div class="murgia-drink">

        Cocktail

      </div>

    {% endfor %}

  </div>

</section>


{% schema %}
{
  "name": "Murgia Drink List",
  "settings": [

    {
  "type": "image_picker",
  "id": "image",
  "label": "Foto cocktail"
},
{
  "type": "checkbox",
  "id": "image_left",
  "label": "Foto a sinistra",
  "default": true
},
{
  "type": "text",
  "id": "title",
  "label": "Nome cocktail"
},
{
  "type": "textarea",
  "id": "description",
  "label": "Descrizione"
},
{
  "type": "range",
  "id": "difficulty",
  "label": "Difficoltà",
  "min": 1,
  "max": 3,
  "step": 1,
  "default": 2
},
{
  "type": "richtext",
  "id": "ingredients",
  "label": "Ingredienti"
},
{
  "type": "richtext",
  "id": "preparation",
  "label": "Preparazione"
},
{
  "type": "text",
  "id": "garnish",
  "label": "Garnish"
}

  ],

  "presets":[

    {
      "name":"Murgia Drink List"
    }

  ]

}
{% endschema %}