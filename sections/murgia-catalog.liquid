<section id="MurgiaCatalog-{{ section.id }}" class="murgia-catalog" style="--catalog-bg: {{ section.settings.background_color }}; --catalog-text: {{ section.settings.text_color }}; --catalog-accent: {{ section.settings.accent_color }};">
  <div class="murgia-catalog__inner">
    <header class="murgia-catalog__header">
      {% if section.settings.eyebrow != blank %}<p class="murgia-catalog__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h1>{{ section.settings.heading }}</h1>{% endif %}
      {% if section.settings.intro != blank %}<div class="murgia-catalog__intro rte">{{ section.settings.intro }}</div>{% endif %}
    </header>

    <div class="murgia-catalog__grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <article class="murgia-catalog-card" {{ block.shopify_attributes }}>
            <a class="murgia-catalog-card__link" href="{{ product.url }}">
              <div class="murgia-catalog-card__media">
                {% if block.settings.badge != blank %}<span class="murgia-catalog-card__badge">{{ block.settings.badge }}</span>{% endif %}
                {% if product.featured_image != blank %}
                  {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'murgia-catalog-card__image', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 749px) 100vw, 50vw', loading: 'lazy' }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'murgia-catalog-card__placeholder' }}
                {% endif %}
              </div>

              <div class="murgia-catalog-card__body">
                <div class="murgia-catalog-card__topline">
                  <h2>
{% if block.settings.custom_title != blank %}
{{ block.settings.custom_title }}
{% else %}
{{ product.title }}
{% endif %}
</h2>
                  <p class="murgia-catalog-card__price">
                    {% if product.compare_at_price > product.price %}<span class="murgia-catalog-card__compare">{{ product.compare_at_price | money }}</span>{% endif %}
                    <span>{{ product.price | money }}</span>
                  </p>
                </div>

                {% if block.settings.description != blank %}
                  <p class="murgia-catalog-card__description">{{ block.settings.description }}</p>
                {% elsif product.description != blank %}
                  <p class="murgia-catalog-card__description">{{ product.description | strip_html | truncate: 125 }}</p>
                {% endif %}
              </div>
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
#shopify-section-{{ section.id }}{background:var(--catalog-bg)}
.murgia-catalog{background:var(--catalog-bg);color:var(--catalog-text)}
.murgia-catalog__inner{width:min(calc(100% - 48px),1180px);margin:0 auto;padding:clamp(76px,8vw,124px) 0 clamp(90px,10vw,150px)}
.murgia-catalog__header{max-width:760px;margin-bottom:clamp(54px,7vw,90px)}
.murgia-catalog__eyebrow{margin:0 0 18px;color:var(--catalog-accent);font-size:10px;font-weight:700;letter-spacing:.3em;text-transform:uppercase}
.murgia-catalog__header h1{margin:0;color:inherit;font-family:Georgia,"Times New Roman",serif;font-size:clamp(58px,6vw,96px);font-weight:400;line-height:.96;letter-spacing:-.05em;text-transform:none!important}
.murgia-catalog__intro{max-width:620px;margin-top:24px;font-size:18px;line-height:1.65}
.murgia-catalog__intro p{margin:0}
.murgia-catalog__grid{
  width:min(100%,980px);
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:40px;
  align-items:start;
}
.murgia-catalog-card__link{display:block;color:inherit;text-decoration:none}
.murgia-catalog-card__media{
  position:relative;
  aspect-ratio: 4 / 4.4;
  max-height:540px;
  overflow:hidden;
  background:#3d285d;
}
.murgia-catalog-card__image,.murgia-catalog-card__placeholder{width:100%;height:100%;display:block;object-fit:cover;transition:transform .7s cubic-bezier(.2,.65,.25,1)}
.murgia-catalog-card:hover .murgia-catalog-card__image{transform:scale(1.025)}
.murgia-catalog-card__badge{position:absolute;top:16px;left:16px;z-index:2;padding:8px 12px;background:var(--catalog-accent);color:#24152e;font-size:9px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}
.murgia-catalog-card__body{padding-top:20px}
.murgia-catalog-card__topline{
display:grid;
grid-template-columns:minmax(0,1fr) auto;
gap:18px;
align-items:start;
min-height:70px;
}
.murgia-catalog-card h2{
margin:0;
color:inherit;
font-family:Georgia,"Times New Roman",serif;
font-size:clamp(24px,2vw,34px);
font-weight:400;
line-height:1.08;
letter-spacing:-.02em;
text-transform:none!important;
}
.murgia-catalog-card__price{margin:3px 0 0;display:flex;gap:8px;font-size:15px;white-space:nowrap}
.murgia-catalog-card__compare{opacity:.55;text-decoration:line-through}
.murgia-catalog-card__description{
max-width:46ch;
margin:10px 0 0;
font-size:13px;
line-height:1.55;
opacity:.78;
min-height:42px;
}
@media screen and (max-width:749px){
  .murgia-catalog__inner{width:calc(100% - 40px);padding:58px 0 86px}
  .murgia-catalog__header{margin-bottom:42px}
  .murgia-catalog__header h1{font-size:clamp(50px,15vw,72px)}
  .murgia-catalog__grid{grid-template-columns:1fr;gap:52px}
  .murgia-catalog-card__topline{grid-template-columns:1fr;gap:10px}
  .murgia-catalog-card__price{justify-content:flex-start}
  .murgia-catalog-card h2{font-size:32px}
}
</style>

{% schema %}
{
  "name":"Murgia Catalogo",
  "tag":"section",
  "class":"murgia-catalog-section",
  "enabled_on":{"templates":["page"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Etichetta","default":"SHOP"},
    {"type":"text","id":"heading","label":"Titolo","default":"Catalogo."},
    {"type":"richtext","id":"intro","label":"Introduzione","default":"<p>Bottiglie e box selezionati. Spedizione rapida in tutta Italia.</p>"},
    {"type":"header","content":"Colori"},
    {"type":"color","id":"background_color","label":"Sfondo","default":"#efe2cf"},
    {"type":"color","id":"text_color","label":"Testo","default":"#24152e"},
    {"type":"color","id":"accent_color","label":"Accento","default":"#cba85e"}
  ],
  "blocks":[
    {
      "type":"product",
      "name":"Prodotto",
      "settings":[
        {"type":"product","id":"product","label":"Prodotto"},
        {"type":"text","id":"custom_title","label":"Titolo mostrato"},
        {"type":"text","id":"badge","label":"Etichetta","default":"Premium"},
        {"type":"textarea","id":"description","label":"Descrizione breve","info":"Lascia vuoto per usare la descrizione del prodotto."}
      ]
    }
  ],
  "presets":[
    {"name":"Murgia Catalogo","blocks":[{"type":"product"},{"type":"product"}]}
  ]
}
{% endschema %}
