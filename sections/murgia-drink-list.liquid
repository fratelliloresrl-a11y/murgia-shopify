<section
  id="MurgiaDrinkList-{{ section.id }}"
  class="murgia-drink-list"
  style="--drink-bg: {{ section.settings.background_color }}; --drink-text: {{ section.settings.text_color }}; --drink-accent: {{ section.settings.accent_color }}; --drink-light: {{ section.settings.light_background }};"
>
 
  <div class="murgia-drink-list__items">
    {% for block in section.blocks %}
  {% assign item_remainder = forloop.index0 | modulo: 2 %}

  <article
    id="{{ block.settings.anchor | default: block.settings.title | handleize }}"
    class="murgia-drink-list__item{% if item_remainder == 1 %} murgia-drink-list__item--reverse{% endif %}"
      >
        <div class="murgia-drink-list__media">
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1800 | image_tag: class: 'murgia-drink-list__image', widths: '600, 900, 1200, 1500, 1800', sizes: '(max-width: 749px) 100vw, 52vw', loading: 'lazy' }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'murgia-drink-list__placeholder' }}
          {% endif %}
        </div>

        <div class="murgia-drink-list__content">
          <div class="murgia-drink-list__number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
          {% if block.settings.title != blank %}<h2>{{ block.settings.title }}</h2>{% endif %}
          {% if block.settings.tagline != blank %}<p class="murgia-drink-list__tagline">{{ block.settings.tagline }}</p>{% endif %}

          {% if block.settings.profile != blank %}
            <div class="murgia-drink-list__profile">
              <p class="murgia-drink-list__label">{{ section.settings.profile_label }}</p>
              <div class="rte">{{ block.settings.profile }}</div>
            </div>
          {% endif %}

          {% if block.settings.link_label != blank %}
            <a class="murgia-drink-list__link" href="{{ block.settings.link | default: '#' }}">
              <span>{{ block.settings.link_label }}</span><span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.settings.final_heading != blank or section.settings.final_text != blank %}
    <div class="murgia-drink-list__final">
      <div class="murgia-drink-list__final-inner">
        {% if section.settings.final_heading != blank %}<h2>{{ section.settings.final_heading }}</h2>{% endif %}
        {% if section.settings.final_text != blank %}<div class="rte">{{ section.settings.final_text }}</div>{% endif %}
        {% if section.settings.final_button_label != blank %}
          <a class="murgia-drink-list__final-link" href="{{ section.settings.final_button_link | default: routes.all_products_collection_url }}">
            <span>{{ section.settings.final_button_label }}</span><span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} { background: var(--drink-bg); }
  .murgia-drink-list { overflow: hidden; background: var(--drink-bg); color: var(--drink-text); }
  .murgia-drink-list__intro p, .murgia-drink-list__profile p, .murgia-drink-list__final .rte p { margin: 0; }
  .murgia-drink-list__items { background: var(--drink-light); }
  .murgia-drink-list__item { min-height: 760px; display: grid; grid-template-columns: 1fr 1fr; background: var(--drink-light); }
  .murgia-drink-list__item--reverse .murgia-drink-list__media { order: 2; }
  .murgia-drink-list__media { min-height: 760px; overflow: hidden; background: #d8c7b4; }
  .murgia-drink-list__image, .murgia-drink-list__placeholder { width: 100%; height: 100%; min-height: 760px; display: block; object-fit: cover; transition: transform 700ms cubic-bezier(.2,.65,.25,1); }
  .murgia-drink-list__item:hover .murgia-drink-list__image { transform: scale(1.025); }
  .murgia-drink-list__content { padding: clamp(72px, 8vw, 130px); display: flex; flex-direction: column; justify-content: center; background: var(--drink-light); }
  .murgia-drink-list__number { margin-bottom: 28px; color: var(--drink-accent); font-size: 11px; font-weight: 700; letter-spacing: .24em; }
  .murgia-drink-list__content h2 { max-width: 9ch; margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(56px, 5.8vw, 92px); font-style: italic; font-weight: 400; line-height: .94; letter-spacing: -.05em; }
  .murgia-drink-list__tagline { max-width: 560px; margin: 28px 0 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(21px, 1.8vw, 30px); font-style: italic; line-height: 1.3; }
  .murgia-drink-list__profile { max-width: 520px; margin-top: 42px; padding-top: 28px; border-top: 1px solid color-mix(in srgb, var(--drink-text) 20%, transparent); font-size: 16px; line-height: 1.7; }
  .murgia-drink-list__link, .murgia-drink-list__final-link { width: fit-content; margin-top: 34px; padding-bottom: 8px; display: inline-flex; align-items: center; gap: 14px; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
  .murgia-drink-list__link span:last-child, .murgia-drink-list__final-link span:last-child { transition: transform 180ms ease; }
  .murgia-drink-list__link:hover span:last-child, .murgia-drink-list__final-link:hover span:last-child { transform: translateX(5px); }
  .murgia-drink-list__final { padding: clamp(100px, 12vw, 180px) 0; background: var(--drink-bg); color: #f7f3ee; text-align: center; }
  .murgia-drink-list__final-inner { width: min(calc(100% - 48px), 980px); margin: 0 auto; }
  .murgia-drink-list__final h2 { margin: 0; font-family: Georgia, "Times New Roman", serif; font-size: clamp(58px, 7vw, 108px); font-style: italic; font-weight: 400; line-height: .95; letter-spacing: -.05em; }
  .murgia-drink-list__final .rte { max-width: 620px; margin: 28px auto 0; font-size: 18px; line-height: 1.65; }
  .murgia-drink-list__final-link { margin-inline: auto; }
  @media screen and (max-width: 989px) {
    .murgia-drink-list__item { min-height: 0; grid-template-columns: 1fr; }
    .murgia-drink-list__item--reverse .murgia-drink-list__media { order: 0; }
    .murgia-drink-list__media, .murgia-drink-list__image, .murgia-drink-list__placeholder { min-height: 72vw; }
  }
  @media screen and (max-width: 749px) {
    .murgia-drink-list__hero h1 { font-size: clamp(58px, 18vw, 82px); }
    .murgia-drink-list__content { padding: 54px 20px 64px; }
    .murgia-drink-list__content h2 { font-size: clamp(48px, 14vw, 66px); }
    .murgia-drink-list__media, .murgia-drink-list__image, .murgia-drink-list__placeholder { min-height: 120vw; }
    .murgia-drink-list__final { padding: 84px 0; }
    .murgia-drink-list__final-inner { width: calc(100% - 40px); }
  }
</style>

{% schema %}
{
  "name": "Murgia Drink List",
  "tag": "section",
  "class": "murgia-drink-list-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etichetta", "default": "DRINK LIST" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Tre interpretazioni. Una sola anima." },
    { "type": "richtext", "id": "intro", "label": "Introduzione", "default": "<p>Ogni Twist racconta una sfumatura diversa della Puglia. Tre modi di vivere Murgia, tre identità, un solo carattere.</p>" },
    { "type": "text", "id": "profile_label", "label": "Titolo profilo", "default": "PROFILO" },
    { "type": "header", "content": "Finale" },
    { "type": "text", "id": "final_heading", "label": "Titolo finale", "default": "Tre Twist. Una sola identità." },
    { "type": "richtext", "id": "final_text", "label": "Testo finale", "default": "<p>Scopri l'aperitivo che dà forma a ogni cocktail.</p>" },
    { "type": "text", "id": "final_button_label", "label": "Etichetta pulsante", "default": "Scopri la bottiglia" },
    { "type": "url", "id": "final_button_link", "label": "Link pulsante" },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "background_color", "label": "Sfondo scuro", "default": "#3d285d" },
    { "type": "color", "id": "light_background", "label": "Sfondo chiaro", "default": "#efe2cf" },
    { "type": "color", "id": "text_color", "label": "Testo", "default": "#3d285d" },
    { "type": "color", "id": "accent_color", "label": "Accento", "default": "#b97a8d" }
  ],
  "blocks": [
    {
      "type": "cocktail",
      "name": "Cocktail",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Immagine" },
        { "type": "text", "id": "anchor", "label": "Ancora URL", "info": "Esempio: murgia-spritz" },
        { "type": "text", "id": "title", "label": "Nome cocktail", "default": "Murgia Spritz" },
        { "type": "text", "id": "tagline", "label": "Frase", "default": "Il tramonto, servito in un calice." },
        { "type": "richtext", "id": "profile", "label": "Profilo aromatico", "default": "<p>Fresco · Mediterraneo · Agrumato</p>" },
        { "type": "text", "id": "link_label", "label": "Etichetta link", "default": "Scopri il cocktail" },
        { "type": "url", "id": "link", "label": "Link pagina cocktail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Murgia Drink List",
      "blocks": [
        { "type": "cocktail", "settings": { "anchor": "murgia-spritz", "title": "Murgia Spritz", "tagline": "Il tramonto, servito in un calice.", "profile": "<p>Fresco · Mediterraneo · Agrumato</p>" } },
        { "type": "cocktail", "settings": { "anchor": "apulian-negroni", "title": "Apulian Negroni", "tagline": "Il classico, con il carattere della Murgia.", "profile": "<p>Intenso · Speziato · Agrumato</p>" } },
        { "type": "cocktail", "settings": { "anchor": "cosmopuglitano", "title": "Cosmopuglitano", "tagline": "Quando la Puglia incontra la notte.", "profile": "<p>Floreale · Fruttato · Vibrante</p>" } }
      ]
    }
  ]
}
{% endschema %}
