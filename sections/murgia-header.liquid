<section id="MurgiaHeader-{{ section.id }}" class="murgia-site-header{% if request.page_type == 'index' %} murgia-site-header--home{% endif %}" style="--mh-bg: {{ section.settings.background_color }}; --mh-text: {{ section.settings.text_color }}; --mh-home-text: {{ section.settings.home_text_color }}; --mh-height: {{ section.settings.desktop_height }}px; --mh-logo-width: {{ section.settings.logo_width }}px;">
  <div class="murgia-site-header__inner">
    <a class="murgia-site-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {% if section.settings.logo != blank %}
        {{ section.settings.logo | image_url: width: 600 | image_tag: class: 'murgia-site-header__logo', widths: '180, 240, 360, 480, 600', sizes: '180px', loading: 'eager' }}
      {% else %}
        <span class="murgia-site-header__wordmark">{{ shop.name }}</span>
      {% endif %}
    </a>

    {% if section.settings.menu != blank %}
      <nav class="murgia-site-header__nav" aria-label="Navigazione principale">
        <ul>
          {% for link in section.settings.menu.links %}
            <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    {% endif %}

    <div class="murgia-site-header__actions">
      {% if section.settings.show_country_label %}
        <span class="murgia-site-header__country">{{ localization.country.currency.iso_code }}</span>
      {% endif %}

      {% if section.settings.show_search %}
        <a class="murgia-site-header__icon" href="{{ routes.search_url }}" aria-label="Cerca">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </a>
      {% endif %}

      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="murgia-site-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.4"></circle><path d="M5.5 20c.7-4 3-6 6.5-6s5.8 2 6.5 6"></path></svg>
        </a>
      {% endif %}

      {% if section.settings.show_cart %}
        <a class="murgia-site-header__icon murgia-site-header__cart" href="{{ routes.cart_url }}" aria-label="Carrello">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8h11l-.7 12H7.2L6.5 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
          {% if cart.item_count > 0 %}<span class="murgia-site-header__count">{{ cart.item_count }}</span>{% endif %}
        </a>
      {% endif %}

      <details class="murgia-site-header__mobile-menu">
        <summary aria-label="Apri menu"><span></span><span></span></summary>
        <div class="murgia-site-header__drawer">
          {% if section.settings.menu != blank %}
            <nav aria-label="Navigazione mobile"><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></nav>
          {% endif %}
          <div class="murgia-site-header__drawer-links">
            {% if section.settings.show_search %}<a href="{{ routes.search_url }}">Cerca</a>{% endif %}
            {% if section.settings.show_account and shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Account</a>{% endif %}
            {% if section.settings.show_cart %}<a href="{{ routes.cart_url }}">Carrello{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>{% endif %}
          </div>
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} { position: relative; z-index: 60; }
  .murgia-site-header { position: sticky; top: 0; width: 100%; color: var(--mh-text); background: color-mix(in srgb, var(--mh-bg) 94%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--mh-text) 12%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .murgia-site-header--home { position: absolute; top: 0; left: 0; color: var(--mh-home-text); background: linear-gradient(180deg, rgba(14, 8, 18, 0.38), transparent); border-bottom-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
  .murgia-site-header__inner { width: min(calc(100% - 48px), 1440px); min-height: var(--mh-height); margin: 0 auto; display: grid; grid-template-columns: minmax(150px, 1fr) auto minmax(150px, 1fr); align-items: center; gap: 30px; }
  .murgia-site-header__brand { justify-self: start; display: inline-flex; align-items: center; color: inherit; text-decoration: none; }
  .murgia-site-header__logo { display: block; width: min(var(--mh-logo-width), 100%); height: auto; }
  .murgia-site-header--home .murgia-site-header__logo { filter: brightness(0) invert(1); }
  .murgia-site-header__wordmark { font-family: Georgia, "Times New Roman", serif; font-size: 28px; font-style: italic; line-height: 1; }
  .murgia-site-header__nav { justify-self: center; }
  .murgia-site-header__nav ul { margin: 0; padding: 0; display: flex; align-items: center; justify-content: center; gap: clamp(24px, 2.4vw, 42px); list-style: none; }
  .murgia-site-header__nav a { position: relative; display: inline-block; padding: 10px 0; color: inherit; font-family: Georgia, "Times New Roman", serif; font-size: 15px; font-weight: 400; line-height: 1; letter-spacing: 0.035em; text-decoration: none; white-space: nowrap; opacity: 0.86; transition: opacity 180ms ease; }
  .murgia-site-header__nav a::after { content: ""; position: absolute; right: 0; bottom: 4px; left: 0; height: 1px; transform: scaleX(0); transform-origin: center; background: currentColor; transition: transform 180ms ease; }
  .murgia-site-header__nav a:hover, .murgia-site-header__nav a[aria-current="page"] { opacity: 1; }
  .murgia-site-header__nav a:hover::after, .murgia-site-header__nav a[aria-current="page"]::after { transform: scaleX(1); }
  .murgia-site-header__actions { justify-self: end; display: flex; align-items: center; gap: 16px; }
  .murgia-site-header__country { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; }
  .murgia-site-header__icon { position: relative; width: 20px; height: 20px; display: inline-grid; place-items: center; color: inherit; text-decoration: none; }
  .murgia-site-header__icon svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .murgia-site-header__count { position: absolute; top: -8px; right: -9px; min-width: 16px; height: 16px; padding: 0 4px; display: grid; place-items: center; border-radius: 99px; background: currentColor; color: var(--mh-bg); font-size: 9px; font-weight: 700; }
  .murgia-site-header__mobile-menu { display: none; }

  @media screen and (max-width: 1100px) {
    .murgia-site-header__inner { grid-template-columns: minmax(120px, 1fr) auto minmax(120px, 1fr); gap: 20px; }
    .murgia-site-header__nav ul { gap: 22px; }
    .murgia-site-header__nav a { font-size: 14px; }
  }

  @media screen and (max-width: 860px) {
    .murgia-site-header { position: sticky; color: var(--mh-text); background: color-mix(in srgb, var(--mh-bg) 96%, transparent); border-bottom-color: color-mix(in srgb, var(--mh-text) 12%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
    .murgia-site-header--home { position: absolute; color: var(--mh-home-text); background: linear-gradient(180deg, rgba(14, 8, 18, 0.46), transparent); border-bottom-color: transparent; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .murgia-site-header__inner { width: calc(100% - 32px); min-height: 66px; grid-template-columns: 1fr auto; }
    .murgia-site-header__logo { width: min(calc(var(--mh-logo-width) * 0.82), 125px); }
    .murgia-site-header__nav, .murgia-site-header__country, .murgia-site-header__actions > .murgia-site-header__icon { display: none; }
    .murgia-site-header__mobile-menu { display: block; position: relative; }
    .murgia-site-header__mobile-menu summary { width: 28px; height: 28px; display: grid; align-content: center; gap: 6px; cursor: pointer; list-style: none; }
    .murgia-site-header__mobile-menu summary::-webkit-details-marker { display: none; }
    .murgia-site-header__mobile-menu summary span { width: 24px; height: 1px; display: block; background: currentColor; transition: transform 180ms ease; }
    .murgia-site-header__mobile-menu[open] summary span:first-child { transform: translateY(3.5px) rotate(45deg); }
    .murgia-site-header__mobile-menu[open] summary span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
    .murgia-site-header__drawer { position: fixed; top: 66px; right: 0; left: 0; min-height: calc(100svh - 66px); padding: 50px 24px; background: var(--mh-bg); color: var(--mh-text); }
    .murgia-site-header__drawer ul { margin: 0; padding: 0; list-style: none; }
    .murgia-site-header__drawer li + li { margin-top: 22px; }
    .murgia-site-header__drawer nav a { color: inherit; font-family: Georgia, "Times New Roman", serif; font-size: clamp(34px, 10vw, 52px); font-style: italic; line-height: 1; text-decoration: none; }
    .murgia-site-header__drawer-links { margin-top: 46px; padding-top: 24px; display: flex; flex-wrap: wrap; gap: 18px 28px; border-top: 1px solid color-mix(in srgb, var(--mh-text) 16%, transparent); }
    .murgia-site-header__drawer-links a { color: inherit; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-decoration: none; text-transform: uppercase; }
  }

  @media (prefers-reduced-motion: reduce) {
    .murgia-site-header__nav a::after, .murgia-site-header__mobile-menu summary span { transition: none; }
  }
</style>

{% schema %}
{
  "name": "Murgia Header",
  "tag": "section",
  "class": "murgia-header-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_width", "min": 80, "max": 220, "step": 5, "unit": "px", "label": "Larghezza logo", "default": 135 },
    { "type": "link_list", "id": "menu", "label": "Menu" },
    { "type": "range", "id": "desktop_height", "min": 60, "max": 100, "step": 2, "unit": "px", "label": "Altezza desktop", "default": 76 },
    { "type": "checkbox", "id": "show_country_label", "label": "Mostra valuta", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Mostra ricerca", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Mostra account", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Mostra carrello", "default": true },
    { "type": "header", "content": "Colori" },
    { "type": "color", "id": "background_color", "label": "Sfondo pagine interne", "default": "#efe2cf" },
    { "type": "color", "id": "text_color", "label": "Testo pagine interne", "default": "#24152e" },
    { "type": "color", "id": "home_text_color", "label": "Testo sopra hero", "default": "#f7f3ee" }
  ],
  "presets": [{ "name": "Murgia Header" }]
}
{% endschema %}
