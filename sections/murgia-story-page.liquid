<section
  id="MurgiaStory-{{ section.id }}"
  class="murgia-story"
  style="
    --story-cream: {{ section.settings.cream_color }};
    --story-purple: {{ section.settings.purple_color }};
    --story-gold: {{ section.settings.gold_color }};
    --story-ink: {{ section.settings.text_color }};
  "
>
  <div class="murgia-story__hero">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'murgia-story__hero-image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {% else %}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'murgia-story__placeholder' }}
    {% endif %}

    <div class="murgia-story__hero-overlay"></div>

    <div class="murgia-story__hero-content">
      {% if section.settings.hero_heading != blank %}
        <h1>{{ section.settings.hero_heading }}</h1>
      {% endif %}
    </div>
  </div>

  <div class="murgia-story__text-section">
    <div class="murgia-story__text">
      {{ section.settings.intro_text }}
    </div>
  </div>

  <div class="murgia-story__botanicals">
    {% if section.settings.botanicals_image != blank %}
      {{
        section.settings.botanicals_image
        | image_url: width: 2400
        | image_tag:
          class: 'murgia-story__botanicals-image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy'
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'murgia-story__placeholder' }}
    {% endif %}

    <div class="murgia-story__botanicals-overlay"></div>

    <div class="murgia-story__botanicals-content">
      {{ section.settings.botanicals_text }}
    </div>
  </div>

  <div class="murgia-story__text-section murgia-story__text-section--second">
    <div class="murgia-story__text">
      {{ section.settings.second_text }}
    </div>
  </div>

  <div class="murgia-story__manifesto">
    <span class="murgia-story__manifesto-line"></span>

    {% if section.settings.manifesto != blank %}
      <blockquote>
        {{ section.settings.manifesto }}
      </blockquote>
    {% endif %}

    <span class="murgia-story__manifesto-line"></span>
  </div>

  {% if section.settings.closing_text != blank %}
    <div class="murgia-story__closing">
      <p>{{ section.settings.closing_text }}</p>
    </div>
  {% endif %}
</section>

<style>
  
  #shopify-section-{{ section.id }} {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

#MurgiaStory-{{ section.id }} {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

body.template-page main#MainContent {
  padding-top: 0 !important;
}

  #MurgiaStory-{{ section.id }} {
    background: var(--story-cream);
    color: var(--story-ink);
  }

  #MurgiaStory-{{ section.id }} *,
  #MurgiaStory-{{ section.id }} *::before,
  #MurgiaStory-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__hero {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__hero-image,
  #MurgiaStory-{{ section.id }} .murgia-story__placeholder {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        90deg,
        rgba(24, 12, 27, 0.38) 0%,
        rgba(24, 12, 27, 0.12) 60%,
        rgba(24, 12, 27, 0.22) 100%
      ),
      linear-gradient(
        180deg,
        rgba(24, 12, 27, 0.08) 0%,
        rgba(24, 12, 27, 0.3) 100%
      );
  }

  #MurgiaStory-{{ section.id }} .murgia-story__hero-content {
  width: min(calc(100% - 48px), 1320px);
  margin: 0 auto;
  padding: 90px 0 70px;
}

  #MurgiaStory-{{ section.id }} .murgia-story__hero h1 {
  max-width: 720px;
  margin: 0;
  color: #fffaf2;
font-family: "Cormorant Garamond", serif;
  font-size: clamp(42px,4.2vw,64px);
  font-style: italic;
  font-weight:500;
  line-height:1.08;
  letter-spacing:-.02em;
}

  #MurgiaStory-{{ section.id }} .murgia-story__text-section {
  background: var(--story-cream);
  padding: clamp(85px, 9vw, 135px) 24px;
}

  #MurgiaStory-{{ section.id }} .murgia-story__text {
  width: min(100%, 820px);
  margin: 0 auto;
  font-family: var(--font-body-family, Arial, sans-serif);
  font-size: clamp(16px, 1.15vw, 18px);
  font-weight: 400;
  line-height: 1.95;
  letter-spacing: 0.015em;
}

  #MurgiaStory-{{ section.id }} .murgia-story__text p {
  margin: 0 0 1.8em;
}

  #MurgiaStory-{{ section.id }} .murgia-story__text p:last-child {
    margin-bottom: 0;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals {
    position: relative;
    min-height: 72vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals-image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(25, 13, 27, 0.42);
  }

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals-content {
  width: min(calc(100% - 48px), 920px);
  margin: 0 auto;
  color: #f8efe0;
  font-family: var(--font-body-family, Arial, sans-serif);
  font-size: clamp(16px, 1.15vw, 19px);
  font-weight: 400;
  line-height: 1.85;
  letter-spacing: 0.01em;
}
#MurgiaStory-{{ section.id }} .murgia-story__botanicals-content strong {
  color: var(--story-gold);
  font-family: var(--font-heading-family, Georgia, serif);
  font-size: clamp(22px, 2.3vw, 34px);
  font-style: italic;
  font-weight: 400;
  line-height: 1.3;
}

#MurgiaStory-{{ section.id }} .murgia-story__botanicals-content ul {
  margin: 28px 0;
  padding: 0;
  list-style: none;
  columns: 2;
  column-gap: 50px;
}

#MurgiaStory-{{ section.id }} .murgia-story__botanicals-content li {
  margin-bottom: 12px;
  color: var(--story-gold);
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals-content p {
    margin: 0 0 1.3em;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__botanicals-content p:last-child {
    margin-bottom: 0;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__manifesto {
    min-height: 500px;
    padding: clamp(100px, 12vw, 170px) 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 36px;
    background: var(--story-purple);
    color: #fffaf2;
    text-align: center;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__manifesto-line {
    width: 70px;
    height: 1px;
    background: var(--story-gold);
  }

  #MurgiaStory-{{ section.id }} .murgia-story__manifesto blockquote {
  width: min(100%, 980px);
  margin: 0 auto;
  color: #fffaf2;
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(54px,5.2vw,82px);
  font-style:italic;
  font-weight:500;
 line-height:1.02;
  letter-spacing:-.03em;
}

  #MurgiaStory-{{ section.id }} .murgia-story__closing {
    padding: clamp(70px, 8vw, 115px) 24px;
    background: var(--story-cream);
    text-align: center;
  }

  #MurgiaStory-{{ section.id }} .murgia-story__closing p {
  width: min(100%, 900px);
  margin: 0 auto;
  color: var(--story-ink);
  font-family:"Cormorant Garamond",serif;
  font-size:clamp(36px,3.5vw,56px);
  font-style:italic;
  font-weight:400;
  line-height:1.25;
letter-spacing:-.02em;
}
  @media screen and (max-width: 749px) {
    #MurgiaStory-{{ section.id }} .murgia-story__hero {
      min-height: 70vh;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__hero-content {
      width: calc(100% - 40px);
      padding: 120px 0 55px;
      align-self: flex-end;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__hero h1 {
  max-width: 100%;
  font-size: clamp(30px, 8.5vw, 44px);
  line-height: 1.12;
}

    #MurgiaStory-{{ section.id }} .murgia-story__text-section {
      padding: 70px 20px;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__botanicals {
      min-height: 68vh;
      align-items: flex-end;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__botanicals-content {
      width: calc(100% - 40px);
      padding: 70px 0 50px;
      font-size: 16px;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__manifesto {
      min-height: 440px;
      padding: 90px 20px;
      gap: 30px;
    }

    #MurgiaStory-{{ section.id }} .murgia-story__manifesto blockquote {
      font-size: clamp(34px, 10vw, 50px);
    }
  }
</style>

{% schema %}
{
  "name": "Murgia — Storia",
  "tag": "section",
  "class": "murgia-story-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Immagine hero"
    },
    {
      "type": "textarea",
      "id": "hero_heading",
      "label": "Frase hero",
      "default": "Ci sono storie che nascono lontano da casa, ma che parlano profondamente delle proprie radici."
    },
    {
      "type": "header",
      "content": "Introduzione"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Testo introduttivo",
      "default": "<p>Questa è la storia di un incontro, nato nel 2023 dentro una città veloce, ma legato profondamente ai paesaggi, ai profumi e alla cultura della Puglia.</p><p>È proprio dalla memoria di quella terra che prende forma Murgia: un aperitivo contemporaneo, capace di raccontare un'identità autentica attraverso botaniche, colore e gusto.</p>"
    },
    {
      "type": "header",
      "content": "Botaniche"
    },
    {
      "type": "image_picker",
      "id": "botanicals_image",
      "label": "Immagine botaniche"
    },
    {
      "type": "richtext",
      "id": "botanicals_text",
      "label": "Testo sull'immagine",
      "default": "<p>Una selezione di botaniche mediterranee incontra una visione moderna dell'aperitivo.</p><p>Profumi, sfumature e contrasti raccontano il carattere della Puglia in una forma nuova.</p>"
    },
    {
      "type": "header",
      "content": "Secondo testo"
    },
    {
      "type": "richtext",
      "id": "second_text",
      "label": "Testo",
      "default": "<p>Murgia non è solo un prodotto, ma un racconto liquido: un equilibrio tra memoria e contemporaneità.</p><p>Ogni dettaglio nasce per trasformare il momento dell'aperitivo in un'esperienza riconoscibile, elegante e profondamente mediterranea.</p>"
    },
    {
      "type": "header",
      "content": "Manifesto"
    },
    {
      "type": "textarea",
      "id": "manifesto",
      "label": "Citazione",
      "default": "Un aperitivo che nasce a Milano, ma che parla la lingua della Puglia."
    },
    {
      "type": "textarea",
      "id": "closing_text",
      "label": "Frase conclusiva",
      "default": "E alla fine, ogni sorso torna a raccontare la terra da cui tutto è cominciato."
    },
    {
      "type": "header",
      "content": "Colori"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Sfondo chiaro",
      "default": "#f4ead8"
    },
    {
      "type": "color",
      "id": "purple_color",
      "label": "Sfondo viola",
      "default": "#2d143f"
    },
    {
      "type": "color",
      "id": "gold_color",
      "label": "Accento oro",
      "default": "#c9a35d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testo",
      "default": "#2d143f"
    }
  ],
  "presets": [
    {
      "name": "Murgia — Storia"
    }
  ]
}
{% endschema %}