<section
  id="MurgiaStory-{{ section.id }}"
  class="murgia-story-page"
  style="
    --story-bg: {{ section.settings.background_color }};
    --story-text: {{ section.settings.text_color }};
    --story-accent: {{ section.settings.accent_color }};
    --story-light: {{ section.settings.light_background }};
  "
>
  <div class="murgia-story-page__hero">
    <div class="murgia-story-page__hero-media">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            class: 'murgia-story-page__hero-image murgia-story-page__hero-image--desktop',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'eager'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'murgia-story-page__placeholder' }}
      {% endif %}

      {% if section.settings.hero_mobile_image != blank %}
        {{
          section.settings.hero_mobile_image
          | image_url: width: 1200
          | image_tag:
            class: 'murgia-story-page__hero-image murgia-story-page__hero-image--mobile',
            widths: '500, 750, 1000, 1200',
            sizes: '100vw',
            loading: 'eager'
        }}
      {% endif %}
    </div>

    <div class="murgia-story-page__hero-overlay"></div>

    <div class="murgia-story-page__hero-content">
      {% if section.settings.eyebrow != blank %}
        <p class="murgia-story-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1>{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.hero_text != blank %}
        <div class="murgia-story-page__hero-text rte">
          {{ section.settings.hero_text }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="murgia-story-page__intro">
    <div>
      {% if section.settings.intro_label != blank %}
        <p class="murgia-story-page__label">{{ section.settings.intro_label }}</p>
      {% endif %}

      {% if section.settings.intro_heading != blank %}
        <h2>{{ section.settings.intro_heading }}</h2>
      {% endif %}
    </div>

    {% if section.settings.intro_text != blank %}
      <div class="murgia-story-page__intro-text rte">
        {{ section.settings.intro_text }}
      </div>
    {% endif %}
  </div>

  <div class="murgia-story-page__chapters">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'chapter' %}
          <article
            class="murgia-story-chapter{% if block.settings.reverse %} murgia-story-chapter--reverse{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="murgia-story-chapter__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1800
                  | image_tag:
                    class: 'murgia-story-chapter__image',
                    widths: '600, 900, 1200, 1500, 1800',
                    sizes: '(max-width: 749px) 100vw, 55vw',
                    loading: 'lazy'
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'murgia-story-chapter__placeholder' }}
              {% endif %}
            </div>

            <div class="murgia-story-chapter__content">
              {% if block.settings.label != blank %}
                <p class="murgia-story-page__label">{{ block.settings.label }}</p>
              {% endif %}

              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="rte">{{ block.settings.text }}</div>
              {% endif %}
            </div>
          </article>

        {% when 'quote' %}
          <div class="murgia-story-quote" {{ block.shopify_attributes }}>
            {% if block.settings.label != blank %}
              <p class="murgia-story-page__label">{{ block.settings.label }}</p>
            {% endif %}

            {% if block.settings.quote != blank %}
              <blockquote>{{ block.settings.quote }}</blockquote>
            {% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>

  {% if section.settings.final_image != blank or section.settings.final_heading != blank %}
    <div class="murgia-story-page__final">
      {% if section.settings.final_image != blank %}
        {{
          section.settings.final_image
          | image_url: width: 2400
          | image_tag:
            class: 'murgia-story-page__final-image',
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy'
        }}
      {% endif %}

      <div class="murgia-story-page__final-overlay"></div>

      <div class="murgia-story-page__final-content">
        {% if section.settings.final_heading != blank %}
          <h2>{{ section.settings.final_heading }}</h2>
        {% endif %}

        {% if section.settings.final_text != blank %}
          <div class="rte">{{ section.settings.final_text }}</div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="murgia-story-page__button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            <span>{{ section.settings.button_label }}</span>
            <span aria-hidden="true">→</span>
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

<style>
  #shopify-section-{{ section.id }} {
    background: var(--story-bg);
  }

  .murgia-story-page {
    overflow: hidden;
    background: var(--story-bg);
    color: var(--story-text);
  }

  .murgia-story-page__hero {
    position: relative;
    min-height: 92svh;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .murgia-story-page__hero-media,
  .murgia-story-page__hero-overlay {
    position: absolute;
    inset: 0;
  }

  .murgia-story-page__hero-media { z-index: -2; }

  .murgia-story-page__hero-overlay {
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(20, 11, 24, 0.72) 0%, rgba(20, 11, 24, 0.16) 72%),
      linear-gradient(180deg, rgba(20, 11, 24, 0.14) 0%, rgba(20, 11, 24, 0.42) 100%);
  }

  .murgia-story-page__hero-image,
  .murgia-story-page__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .murgia-story-page__hero-image--mobile { display: none; }

  .murgia-story-page__hero-content {
    width: min(calc(100% - 48px), 1380px);
    padding: 130px 0 80px;
    color: #f7f3ee;
  }

  .murgia-story-page__eyebrow,
  .murgia-story-page__label {
    margin: 0 0 18px;
    color: var(--story-accent);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .murgia-story-page__hero-content h1 {
    max-width: 9ch;
    margin: 0;
    color: inherit;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(68px, 8.5vw, 138px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .murgia-story-page__hero-text {
    max-width: 560px;
    margin-top: 34px;
    font-size: clamp(17px, 1.35vw, 21px);
    line-height: 1.65;
  }

  .murgia-story-page__hero-text p,
  .murgia-story-page__intro-text p,
  .murgia-story-chapter__content .rte p,
  .murgia-story-page__final-content .rte p {
    margin: 0;
  }

  .murgia-story-page__intro {
    width: min(calc(100% - 48px), 1380px);
    margin: 0 auto;
    padding: clamp(90px, 10vw, 150px) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.75fr);
    gap: clamp(46px, 8vw, 130px);
    align-items: start;
  }

  .murgia-story-page__intro h2 {
    max-width: 10ch;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(52px, 5.8vw, 92px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .murgia-story-page__intro-text {
    padding-top: 28px;
    font-size: clamp(18px, 1.45vw, 23px);
    line-height: 1.65;
  }

  .murgia-story-page__chapters {
    background: var(--story-light);
  }

  .murgia-story-chapter {
    min-height: 720px;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
  }

  .murgia-story-chapter--reverse {
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .murgia-story-chapter--reverse .murgia-story-chapter__media {
    order: 2;
  }

  .murgia-story-chapter__media {
    min-height: 100%;
    overflow: hidden;
    background: #d8c7b4;
  }

  .murgia-story-chapter__image,
  .murgia-story-chapter__placeholder {
    width: 100%;
    height: 100%;
    min-height: 720px;
    display: block;
    object-fit: cover;
  }

  .murgia-story-chapter__content {
    padding: clamp(70px, 8vw, 130px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--story-light);
    color: var(--story-text);
  }

  .murgia-story-chapter__content h2 {
    max-width: 10ch;
    margin: 0 0 32px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 5vw, 80px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .murgia-story-chapter__content .rte {
    max-width: 520px;
    font-size: clamp(17px, 1.25vw, 20px);
    line-height: 1.7;
  }

  .murgia-story-quote {
    padding: clamp(100px, 12vw, 180px) 24px;
    background: var(--story-bg);
    color: var(--story-text);
    text-align: center;
  }

  .murgia-story-quote blockquote {
    width: min(100%, 1080px);
    margin: 0 auto;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(48px, 6vw, 96px);
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .murgia-story-page__final {
    position: relative;
    min-height: 82svh;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .murgia-story-page__final-image,
  .murgia-story-page__final-overlay {
    position: absolute;
    inset: 0;
  }

  .murgia-story-page__final-image {
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .murgia-story-page__final-overlay {
    z-index: -1;
    background: rgba(20, 11, 24, 0.56);
  }

  .murgia-story-page__final-content {
    width: min(calc(100% - 48px), 900px);
    padding: 90px 0;
    color: #f7f3ee;
    text-align: center;
  }

  .murgia-story-page__final-content h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(58px, 7vw, 108px);
    font-style: italic;
    font-weight: 400;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .murgia-story-page__final-content .rte {
    max-width: 620px;
    margin: 30px auto 0;
    font-size: 18px;
    line-height: 1.65;
  }

  .murgia-story-page__button {
    margin-top: 36px;
    padding-bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    border-bottom: 1px solid currentColor;
    color: inherit;
    text-decoration: none;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .murgia-story-page__intro {
      grid-template-columns: 1fr;
    }

    .murgia-story-page__intro-text {
      padding-top: 0;
    }

    .murgia-story-chapter,
    .murgia-story-chapter--reverse {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .murgia-story-chapter--reverse .murgia-story-chapter__media {
      order: 0;
    }

    .murgia-story-chapter__image,
    .murgia-story-chapter__placeholder {
      min-height: 64vw;
    }
  }

  @media screen and (max-width: 749px) {
    .murgia-story-page__hero {
      min-height: 88svh;
    }

    .murgia-story-page__hero-image--mobile {
      display: block;
    }

    .murgia-story-page__hero-image--mobile + .murgia-story-page__hero-image--desktop {
      display: none;
    }

    .murgia-story-page__hero-content {
      width: calc(100% - 40px);
      padding: 120px 0 48px;
      align-self: end;
    }

    .murgia-story-page__hero-content h1 {
      max-width: 8ch;
      font-size: clamp(58px, 18vw, 82px);
    }

    .murgia-story-page__intro {
      width: calc(100% - 40px);
      padding: 70px 0;
      gap: 32px;
    }

    .murgia-story-page__intro h2 {
      font-size: clamp(46px, 14vw, 64px);
    }

    .murgia-story-chapter__image,
    .murgia-story-chapter__placeholder {
      min-height: 112vw;
    }

    .murgia-story-chapter__content {
      padding: 54px 20px 64px;
    }

    .murgia-story-chapter__content h2 {
      font-size: clamp(44px, 13vw, 60px);
    }

    .murgia-story-quote {
      padding: 80px 20px;
    }

    .murgia-story-quote blockquote {
      font-size: clamp(42px, 13vw, 62px);
    }

    .murgia-story-page__final {
      min-height: 76svh;
    }

    .murgia-story-page__final-content {
      width: calc(100% - 40px);
      padding: 70px 0;
    }
  }
</style>

{% schema %}
{
  "name": "Murgia Storia",
  "tag": "section",
  "class": "murgia-story-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Immagine hero desktop"
    },
    {
      "type": "image_picker",
      "id": "hero_mobile_image",
      "label": "Immagine hero mobile"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Etichetta",
      "default": "LA NOSTRA STORIA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Una Puglia da bere."
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Testo hero",
      "default": "<p>Murgia nasce dal desiderio di raccontare la Puglia attraverso un aperitivo contemporaneo, riconoscibile e profondamente mediterraneo.</p>"
    },
    {
      "type": "header",
      "content": "Introduzione"
    },
    {
      "type": "text",
      "id": "intro_label",
      "label": "Etichetta",
      "default": "LE ORIGINI"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Titolo",
      "default": "Un'idea nata qui."
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Testo",
      "default": "<p>Non volevamo creare semplicemente un nuovo aperitivo. Volevamo dare forma a un'identità: il carattere della nostra terra, i suoi profumi e il suo modo spontaneo di stare insieme.</p>"
    },
    {
      "type": "header",
      "content": "Finale"
    },
    {
      "type": "image_picker",
      "id": "final_image",
      "label": "Immagine finale"
    },
    {
      "type": "text",
      "id": "final_heading",
      "label": "Titolo finale",
      "default": "Il nuovo colore dell'aperitivo."
    },
    {
      "type": "richtext",
      "id": "final_text",
      "label": "Testo finale",
      "default": "<p>Un aperitivo che porta la Puglia in ogni calice, tra botaniche mediterranee e una visione nuova del gusto.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Etichetta pulsante",
      "default": "Scopri Murgia"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link pulsante"
    },
    {
      "type": "header",
      "content": "Colori"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Sfondo scuro",
      "default": "#3d285d"
    },
    {
      "type": "color",
      "id": "light_background",
      "label": "Sfondo chiaro",
      "default": "#efe2cf"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Testo",
      "default": "#3d285d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accento",
      "default": "#d59aa5"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Capitolo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Immagine"
        },
        {
          "type": "checkbox",
          "id": "reverse",
          "label": "Immagine a destra",
          "default": false
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etichetta",
          "default": "CAPITOLO"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Titolo",
          "default": "Il carattere della terra."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Testo",
          "default": "<p>La Puglia ci ha insegnato a riconoscere il valore delle cose autentiche: ingredienti scelti, gesti semplici e sapori capaci di restare nella memoria.</p>"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Citazione",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etichetta",
          "default": "IL NOSTRO MANIFESTO"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Citazione",
          "default": "Murgia non segue le regole. Le riscrive."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Murgia Storia",
      "blocks": [
        {
          "type": "chapter",
          "settings": {
            "label": "LA TERRA",
            "heading": "Il carattere della Puglia.",
            "text": "<p>Una terra intensa, generosa e piena di contrasti. È da qui che nasce il profilo di Murgia: mediterraneo, aromatico e contemporaneo.</p>"
          }
        },
        {
          "type": "chapter",
          "settings": {
            "reverse": true,
            "label": "LA VISIONE",
            "heading": "Tradizione, senza nostalgia.",
            "text": "<p>Abbiamo guardato alle botaniche della nostra terra con occhi nuovi, trasformandole in un aperitivo pensato per il presente.</p>"
          }
        },
        {
          "type": "quote",
          "settings": {
            "label": "IL NOSTRO MANIFESTO",
            "quote": "Murgia non segue le regole. Le riscrive."
          }
        }
      ]
    }
  ]
}
{% endschema %}
